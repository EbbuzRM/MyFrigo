# ── Client (bundled into the app — public values only) ───────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id-here
EXPO_PUBLIC_HCAPTCHA_SITEKEY=your_hcaptcha_sitekey_here

# E2E test harness / dev diagnostics only (never set in production builds)
EXPO_PUBLIC_E2E_TEST_MODE=false
EXPO_PUBLIC_E2E_FUNCTION_SECRET=shared-with-e2e-otp-function
EXPO_PUBLIC_ADMIN_TASK_SECRET=shared-with-delete-all-users-function

# ── Edge function secrets (server-side, set via `supabase secrets set`) ───────
# NOT prefixed EXPO_PUBLIC_ — these must never reach the client bundle.
#   SUPABASE_SERVICE_ROLE_KEY   (auto-injected by the platform)
#   SUPABASE_ANON_KEY           (auto-injected by the platform)
#   OCR_SPACE_API_KEY           -> ocr-proxy
#   RESEND_API_KEY              -> send-feedback
#   FEEDBACK_TO_EMAIL           -> send-feedback (recipient inbox)
#   ONESIGNAL_APP_ID            -> send-expiration-notifications
#   ONESIGNAL_REST_API_KEY      -> send-expiration-notifications
#   CRON_SECRET / FUNCTION_SECRET_KEY -> send-expiration-notifications
#   E2E_FUNCTION_SECRET         -> e2e-otp        (must match EXPO_PUBLIC_E2E_FUNCTION_SECRET)
#   ADMIN_TASK_SECRET           -> delete-all-users
#   ENVIRONMENT                 -> "development" | "staging" | "production"
